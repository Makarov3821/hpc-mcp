#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
from pathlib import Path
from typing import Tuple, Optional, List

#-----------------------------------------------------------------------------------------------------------------
# USER CONFIGURATION - Modify before using!
# Job control system, could be lsf, slurm, pbs/torque
CONTROL_SYSTEM = "lsf"
# THe path containing REST sifs
REST_PATH = "/share/home/ylzhao/software/rest-sifs"
# REST version to use if let blank
DEFAULT_VERSION = "260819"
# Modify this if you are to use mpi version
MPI_ENV_COMMAND = "source /share/apps/intel2020u4/parallel_studio_xe_2020/psxevars.sh"

# The format of REST sif to find in REST_PATH
IMAGE = f"rest_{DEFAULT_VERSION}.sif"
#-----------------------------------------------------------------------------------------------------------------

'''
qrest.py - Python version of qrest.sh for submitting REST calculations

Regenerated by zyl with help of Deepseek on Nov 2025

Version:

1.0 (ver 4.0 of qrest.sh) - Add an additional choice of IMAGE, for various named REST sifs.

#################################################################
# SEVERE HINT:                                                  #
# ALL sif versions before 260313 is converted in old apptainer  #
# Thus, direct running in new apptainer may encounter problems. #
# We're considering archiving these old images, so at this time #
# USE WITH CAUTION!                                             #
