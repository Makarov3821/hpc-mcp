'''

# Queue configuration with (default_procs, qprocs, qmem)
QUEUE_CONFIG = {
    "xp24mc4": (24, 24, 4), "xppn1": (112, 28, 6), "xppn2": (112, 28, 6),
    "xp40mc12": (40, 40, 12), "xxchem": (40, 40, 12), "xp72mc10": (72, 72, 10),
    "xp48mc8": (48, 48, 8), "Gaussian": (28, 28, 6), "xp36mc10": (36, 36, 10),
    "Coding": (36, 36, 4), "Small": (4, 8, 4), "AMD": (24, 24, 4),
    "AMD9654": (32, 192, 8), "Single": (1, 1, 4)
}

class RESTSubmitter:
    """Main class for submitting REST jobs"""
    
    def __init__(self):
        self.args = None
    
    def print_usage(self):
        """Print help information"""
        examples = {
            "lsf": [
                "qrest.py -q small -p 4 -v 250329 -t mpi <your-job-name>",
                "qrest.py -q AMD9654 -p 32 -S -P <your-job-name>",
                "qrest.py -q xp72mc10 -p 28 -r ../dataset1 -m xc07n02"
            ],
            "slurm": [
                "qrest.py -q compute -p 8 -v 250329 -t mpi <your-job-name>",
                "qrest.py -q default -p 4 -S -P <your-job-name>", 
                "qrest.py -q intel -p 56 -r ../dataset1 -P -S"
            ],
            "torque": [
                "qrest.py -q batch -p 4 -v 250329 -t mpi <your-job-name>",
                "qrest.py -q long -p 32 -S -P <your-job-name>",
                "qrest.py -q amd -p 128 -r ../dataset1 -P -S"
            ]
        }
        
        print(f"""
------
  qrest - Submit REST Calculations

  Note: Control system is set to '{CONTROL_SYSTEM}'

  #################################################################
  # SEVERE HINT:                                                  #
  # ALL sif versions before 260313 is converted in old apptainer  #
  # Thus, direct running in new apptainer may encounter problems. #
  # We're considering archiving these old images, so at this time #
  # USE WITH CAUTION!                                             #
  #################################################################

------

Usage:
  -q, --queue     <str>  Queue to submit to               [default: single]
  -p, --procs     <int>  Processes to use                 [default: 1]
  -m, --machine   <str>  Node to submit to                [default: None]  
  -v, --version   <str>  REST version                     [default: {DEFAULT_VERSION}]
  -t, --type      <str>  Run type (openmp/mpi)            [default: openmp]
  -r, --recursive <str>  Submit all ctrl.in in directory  [default: .]
  -S, --suppress         Suppress output
  -P, --pause            Generate but don't submit
  -y, --yes              Auto confirm (no prompt)
  -h, --help             Show this help

Examples:""")
        for ex in examples.get(CONTROL_SYSTEM, examples["lsf"]):
            print(f"  {ex}")
        print("------")
    
    def parse_arguments(self):
        """Parse command line arguments"""
        parser = argparse.ArgumentParser(description='Submit REST calculations', add_help=False)
        parser.add_argument('-q', '--queue', default='single', help='Queue name')
        parser.add_argument('-p', '--procs', type=int, default=1, help='Number of processes')
        parser.add_argument('-m', '--machine', default='', help='Specific node')
        parser.add_argument('-v', '--version', default=DEFAULT_VERSION, help='REST version')
        parser.add_argument('-t', '--type', choices=['openmp', 'mpi'], default='openmp', help='Run type')
        parser.add_argument('-r', '--recursive', nargs='?', const='.', help='Recursive directory')
        parser.add_argument('-S', '--suppress', action='store_true', help='Suppress output')
        parser.add_argument('-P', '--pause', action='store_true', help='Generate only, don\'t submit')
        parser.add_argument('-y', '--yes', action='store_true', help='Auto confirm (no prompt)')
        parser.add_argument('jobname', nargs='?', help='Job name')
        
        args = parser.parse_args()

        # Detect which optional arguments were explicitly provided by the user
        # We inspect sys.argv to know whether an option string was present.
        provided = set()
        for action in parser._actions:
            if not action.option_strings:
                continue
            for opt in action.option_strings:
                if opt in sys.argv:
                    provided.add(action.dest)
                    break
        # detect positional `jobname` presence (any non-option argv after script)
        if any(not a.startswith('-') for a in sys.argv[1:]):
            provided.add('jobname')

        # Print notices for options that are using defaults (skip if suppressed)
        if not getattr(args, 'suppress', False):
            opt_map = [
                ('queue', '-q/--queue'),
                ('procs', '-p/--procs'),
                ('version', '-v/--version'),
                ('type', '-t/--type'),
            ]
            for dest, label in opt_map:
                if dest not in provided:
                    default_val = parser.get_default(dest)
                    print(f"Notice: {label} not provided. Using default: {default_val}")

        # Validate configuration
        if CONTROL_SYSTEM not in ['lsf', 'slurm', 'torque']:
            self.error_exit(f"Invalid CONTROL_SYSTEM '{CONTROL_SYSTEM}'. Must be lsf, slurm, or torque!")
        
        if not args.recursive and not args.jobname:
            self.error_exit("Please specify a job name!")
        
        # Set default processes based on queue
        if args.procs <= 0:
            self.error_exit(f"Processes nuumber should be a positive integer!")
        
        # Generate image name based on IMAGE and version
        image_name = IMAGE.replace(DEFAULT_VERSION, args.version)
        # Validate REST version
        rest_file = Path(REST_PATH) / image_name
        if not rest_file.exists():
            parts = IMAGE.split(DEFAULT_VERSION)
            available = []
            for file in Path(REST_PATH).glob(f"{parts[0]}*{parts[1]}"):
                ver = file.name.replace(parts[0], '').replace(parts[1], '')
                available.append(ver)
            self.error_exit(f"REST version {args.version} not found!\nAvailable: {', '.join(available)}")
        
        # Check for ctrl.in in single job mode
        if not args.recursive and not Path("ctrl.in").exists():
            self.error_exit("No ctrl.in file in current directory!")
        
        return args
    
    def get_default_procs(self, queue: str) -> int:
        """Get default number of processes for queue"""
        if queue in QUEUE_CONFIG:
            if not self.args.suppress:
                print(f"Using default nproc for {queue}: {QUEUE_CONFIG[queue][0]}")
            return QUEUE_CONFIG[queue][0]
        else:
            if not self.args.suppress:
                print(f"Warning: Unknown queue {queue}, using 1 process")
            return 1
    
    def get_queue_config(self, queue: str) -> Tuple[int, int]:
        """Get queue configuration (qprocs, qmem)"""
        return QUEUE_CONFIG.get(queue, (1, 4))[1:3]
    
    def error_exit(self, message: str):
        """Print error message and exit"""
        print(f"Error: {message}")
        sys.exit(1)
    
    def update_ctrl_file(self, cores: int):
        """Update num_threads in ctrl.in file"""
        ctrl_file = Path("ctrl.in")
        if not ctrl_file.exists():
            return
        
        content = ctrl_file.read_text().splitlines()
        for i, line in enumerate(content):
            if "num_threads" in line:
                # Simple replacement - assumes format with spaces
                #content[i] = f"\tnum_threads =               {cores}"
                # A better way to keep formatting
                cores_str = line.split()[-1]
                if cores_str != str(cores):
                    # Only update if the value is different
                    content[i] = line.replace(cores_str, str(cores))
                    ctrl_file.write_text('\n'.join(content))
                    if not self.args.suppress :
                        print(f"Updated num_threads = {cores} in ctrl.in")
                    break
    
    def generate_run_command(self) -> str:
        """Generate the REST run command based on type"""
        
        rest_cmd = f"{REST_PATH}/rest_{self.args.version}.sif > rest.log"
        
        if self.args.type == "openmp":
            return f"export OMP_NUM_THREADS={self.args.procs}\n{rest_cmd}"
        else:
            return f"{MPI_ENV_COMMAND}\nexport OMP_NUM_THREADS=1\nmpirun -np {self.args.procs} {rest_cmd}"
    
    def generate_submission_script(self, job_name: str, job_dir: Path) -> Tuple[str, str]:
        """Generate submission script content and filename"""
        run_cmd = self.generate_run_command()
        curr_dir = str(job_dir)
        
        if CONTROL_SYSTEM == "lsf":
            qprocs, qmem = self.get_queue_config(self.args.queue)
            script = f"""#BSUB -J {job_name}
#BSUB -q {self.args.queue}
#BSUB -M {self.args.procs * qmem}G
#BSUB -n {self.args.procs}
#BSUB -o {job_name}-%J.out
{"#BSUB -m " + self.args.machine if self.args.machine else ""}

cd {curr_dir}
touch RUNNING
trap 'rm -f RUNNING' EXIT

{run_cmd}
"""
            return script, f"{job_name}.bsub"
        
        elif CONTROL_SYSTEM == "slurm":
            script = f"""#!/bin/bash
#SBATCH -J {job_name}
#SBATCH -p {self.args.queue}
#SBATCH -n {self.args.procs}
#SBATCH --output={job_name}-%j.out
{"#SBATCH -w " + self.args.machine if self.args.machine else ""}

cd {curr_dir}
touch RUNNING
trap 'rm -f RUNNING' EXIT

{run_cmd}
"""
            return script, f"{job_name}.slurm"
        
        else:  # torque
            script = f"""#!/bin/bash
#PBS -N {job_name}
#PBS -q {self.args.queue}
#PBS -l nodes=1:ppn={self.args.procs}
#PBS -j oe
#PBS -o {job_name}-$PBS_JOBID.out

cd $PBS_O_WORKDIR
touch RUNNING
trap 'rm -f RUNNING' EXIT

{run_cmd}
"""
            return script, f"{job_name}.pbs"
    
    def submit_job(self, job_dir: Path, job_name: str):
        """Submit a single job"""
        original_dir = Path.cwd()
        
        try:
            os.chdir(job_dir)
        except OSError:
            print(f"Error: Cannot access {job_dir}")
            return
        
        if not Path("ctrl.in").exists():
            print(f"Warning: No ctrl.in in {job_dir}")
            os.chdir(original_dir)
            return
        
        # Update ctrl.in
        self.update_ctrl_file(1 if self.args.type == "mpi" else self.args.procs)
        
        # Generate and write submission script
        script_content, script_file = self.generate_submission_script(job_name, Path.cwd())
        Path(script_file).write_text(script_content)
        
        # Submit job if not in pause mode
        if not self.args.pause:
            self.execute_submission(script_file)
            if not self.args.suppress:
                print(f"Submitted: {job_name} ({job_dir})")
        elif not self.args.suppress:
            print(f"Generated: {job_name} ({job_dir})")
        
        os.chdir(original_dir)
    
    def execute_submission(self, script_file: str):
        """Execute the job submission command"""
        cmd_map = {
            "lsf": ["bsub"],
            "slurm": ["sbatch", script_file],
            "torque": ["qsub", script_file]
        }
        
        cmd = cmd_map[CONTROL_SYSTEM]
        stdout = subprocess.DEVNULL if self.args.suppress else None
        
        try:
            if CONTROL_SYSTEM == "lsf":
                with open(script_file, 'r') as f:
                    subprocess.run(cmd, stdin=f, stdout=stdout, stderr=stdout)
            else:
                subprocess.run(cmd, stdout=stdout, stderr=stdout)
        except Exception as e:
            print(f"Submission error: {e}")
    
    def find_ctrl_files(self, directory: str) -> List[Path]:
        """Find all ctrl.in files recursively"""
        return list(Path(directory).rglob("ctrl.in"))
    
    def run(self):
        """Main execution function"""
        if len(sys.argv) == 1 or '-h' in sys.argv or '--help' in sys.argv:
            self.print_usage()
            return
        
        self.args = self.parse_arguments()
        
        if self.args.recursive:
            recursive_dir = Path(self.args.recursive)
            if not recursive_dir.exists():
                self.error_exit(f"Directory '{recursive_dir}' not found!")
            
            ctrl_files = self.find_ctrl_files(recursive_dir)
            total_jobs = len(ctrl_files)

            if not self.args.suppress and total_jobs > 0:
                print("\n" + "="*55)
                print(f" 任务预扫描报告 (qrest)")
                print("="*55)
                print(f" 扫描路径     : {recursive_dir.absolute()}")
                print(f" 队列 (Queue) : {self.args.queue}")
                print(f" 版本 (Ver)   : {self.args.version}")
                print(f" 找到作业总数 : {total_jobs}")
                if self.args.pause:
                    print(f" \033[96m模式 (Mode)   : PAUSE (仅生成脚本，不提交)\033[0m")
                print("-" * 55)
                
                if not getattr(self.args, 'yes', False):
                    try:
                        confirm = input(f"\n 是否处理这 {total_jobs} 个作业? [y/N]: ").strip().lower()
                    except KeyboardInterrupt:
                        print("\nAborted.")
                        sys.exit(1)
                    if confirm != 'y':
                        print("已取消。")
                        sys.exit(0)
                        
                print(f"\n开始提交...\n")
            
            success_count = 0
            for i, ctrl_file in enumerate(ctrl_files, 1):
                job_dir = ctrl_file.parent
                job_name = job_dir.name
                if not self.args.suppress:
                    print(f"[{i}/{total_jobs}] ", end='', flush=True)
                self.submit_job(job_dir, job_name)
                success_count += 1
                
            if not self.args.suppress:
                print(f"\n全部完成。成功处理 REST 任务数: {success_count}/{total_jobs}")
        else:
            # Single job submission
            self.update_ctrl_file(1 if self.args.type == "mpi" else self.args.procs)
            
            script_content, script_file = self.generate_submission_script(
                self.args.jobname, Path.cwd()
            )
            Path(script_file).write_text(script_content)
            
            if not self.args.pause:
                self.execute_submission(script_file)

def main():
    """Entry point"""
    submitter = RESTSubmitter()
    submitter.run()

if __name__ == "__main__":
    main()
