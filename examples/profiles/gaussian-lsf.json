{
  "scheduler": "lsf",
  "spec": {
    "command": ["g16"],
    "resources": {
      "queue": "{{queue}}",
      "cpus": "{{cpus}}",
      "memory_mb": "{{memory_mb}}",
      "memory_scope": "lsf_reservation",
      "time_minutes": "{{time_minutes}}"
    },
    "setup_steps": [
      {"kind": "export", "name": "g16root", "value": "/REMOTE/gaussian"},
      {"kind": "source", "path": "/REMOTE/gaussian/g16/bsd/g16.profile"}
    ],
    "stdin": "{{input}}",
    "stdout": "{{stem}}.log"
  },
  "parameters": {
    "input": {"type": "string", "description": "Relative input card; required"},
    "stem": {"type": "string", "description": "Output stem matching the card checkpoint"},
    "queue": {"type": "string", "default": "Gaussian", "description": "Example only; confirm site queue"},
    "cpus": {"type": "integer", "default": 4},
    "memory_mb": {"type": "integer", "default": 8192},
    "time_minutes": {"type": "integer", "default": 10}
  },
  "input_files": ["{{input}}"],
  "outputs": ["{{stem}}.log", "{{stem}}.chk"]
}
