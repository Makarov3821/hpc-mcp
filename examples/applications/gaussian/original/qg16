def check_job_finished(gjf_path):
    """检查对应的 log 文件是否存在且包含 'Normal termination'"""
    log_path = gjf_path.with_suffix('.log')
    if not log_path.exists():
        return False
    try:
        with open(log_path, 'rb') as f:
            try:
                f.seek(-2048, 2)
            except OSError:
                f.seek(0)
            last_lines = f.read().decode('utf-8', errors='ignore')
        if "Normal termination of Gaussian 16" in last_lines:
            return True
    except Exception:
        return False
    return False

def resolve_path_robust(raw_path_str):
    """
    全能路径解析器：处理 ~，$HOME，ANSI颜色，以及相对路径
    """
    if not raw_path_str:
        return None  # 改为返回 None 以便后续判断

    # 1. 清理 ANSI 颜色和引号
    ansi_escape = re.compile(r'\x1b\[[0-9;]*m')
    clean_path = ansi_escape.sub('', raw_path_str)
    clean_path = clean_path.replace('\\', '').strip('"\'')
    
    # 2. 基础展开
    clean_path = os.path.expanduser(clean_path)
    clean_path = os.path.expandvars(clean_path)

    # 3. 强制替换 $HOME
    user_home = str(Path.home())
    if "$HOME" in clean_path:
        clean_path = clean_path.replace("$HOME", user_home)
    if "${HOME}" in clean_path:
        clean_path = clean_path.replace("${HOME}", user_home)

    return clean_path

def get_job_cwd_from_details(job_id):
    try:
        res = subprocess.run(["bjobs", "-l", str(job_id)], 
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if res.returncode != 0: return None
        output = res.stdout
        
        # 提取路径字符串
        raw_cwd = None
        match_angle = re.search(r'(?:CWD|directory)\s*<\s*([^>]+)\s*>', output)
        if match_angle: 
            raw_cwd = match_angle.group(1).strip()
        else:
            match_colon = re.search(r'(?:CWD|directory)\s*:\s*([^\n]+)', output)
            if match_colon: 
                raw_cwd = match_colon.group(1).strip()

        if raw_cwd:
            # 【修复代码】：清除 LSF 输出中的换行符和缩进空格
            # 将 "smx-degr\n                      ade" 拼接回 "smx-degrade"
            raw_cwd = re.sub(r'\n\s*', '', raw_cwd)
        
        # 【关键修复】：这里提取出来的 CWD 也必须进行展开！
        # 否则如果是 <$HOME/test>，后续会被当成相对路径
        return resolve_path_robust(raw_cwd)
            
    except Exception:
        pass
    return None

def get_active_file_paths():
    active_paths = set()
    try:
        cmd = ["bjobs", "-o", "id exec_cwd:1000 command:4096", "-noheader"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if res.returncode != 0: return set()

        gjf_pattern = re.compile(r'[\"\']?([^\s\"\']+\.gjf)[\"\']?')
        lines = res.stdout.splitlines()
        
        for line in lines:
            line = line.strip()
            if not line: continue
            
            parts = line.split(maxsplit=2)
            if len(parts) < 3: continue
            
            job_id, cwd_str, command_str = parts[0], parts[1], parts[2]
            
            # --- 步骤1：确定 Job 的工作目录 (CWD) ---
            valid_cwd = None
            
            # 即使 bjobs -o 返回了路径，也最好过一遍 robust 解析，以防万一
            if cwd_str != '-' and cwd_str.strip():
                valid_cwd = resolve_path_robust(cwd_str)
            else:
                # Pend 任务查询详情 (函数内部已经做了 resolve_path_robust)
                valid_cwd = get_job_cwd_from_details(job_id)
            
            # 生成 Path 对象
            valid_cwd_path = None
            if valid_cwd:
                try:
                    p_cwd = Path(valid_cwd)
                    # 只有当它是绝对路径时，我们才信任它
                    if p_cwd.is_absolute():
                        valid_cwd_path = p_cwd
                except:
                    pass

            # --- 步骤2：从 Command 中提取 .gjf ---
            found_gjfs = gjf_pattern.findall(command_str)
            
            for gjf_str in found_gjfs:
                # 对文件名进行展开 (处理 $HOME/run.gjf 的情况)
                expanded_name = resolve_path_robust(gjf_str)
                if not expanded_name: continue

                p = Path(expanded_name)
                
                try:
                    # Case A: 文件名本身已经是绝对路径
                    if p.is_absolute():
                        active_paths.add(str(p.resolve()))
                    
                    # Case B: 文件名是相对路径，且我们有合法的绝对路径 CWD
                    elif valid_cwd_path:
                        full_path = (valid_cwd_path / p).resolve()
                        active_paths.add(str(full_path))
                    
                    # Case C: 无法定位
                    else:
                        continue
                        
                except Exception:
                    continue
                    
    except Exception as e:
        print(f"Warning: {e}")
        return set()
    
    return active_paths

def parse_mem_to_mb(mem_str):
    """
    将 Gaussian 的内存字符串 (e.g. '100GB', '80000MB', '20000000') 转换为 MB (int)。
    默认单位(无后缀)在Gaussian中通常指Words(8bytes)，这里简单起见，
    如果无后缀且数值很大，按 Gaussian 默认 Words 处理；
    但为了 LSF 安全，建议尽量使用带单位的字符串。
    """
    if not mem_str:
        return 0
    
    mem_str = mem_str.upper().strip()
    # 匹配数值和单位
    match = re.match(r'^(\d+)([A-Z]+)?$', mem_str)
    if not match:
        return 0
        
    val = int(match.group(1))
    unit = match.group(2)
    
    if unit == 'GB':
        return val * 1024
    elif unit == 'TB':
        return val * 1024 * 1024
    elif unit == 'MB':
        return val
    elif unit == 'KW': # KiloWords
        return int(val * 8 / 1024) 
    elif unit == 'MW': # MegaWords approx 8MB
        return val * 8 
    elif unit == 'GW': 
        return val * 8 * 1024
    elif unit is None:
        # 无单位，Gaussian默认是Words (8 bytes for 64bit)
        # 1 Word = 8 Bytes. 1 MB = 1024*1024 Bytes.
        # Val Words = Val * 8 / (1024*1024) MB
        return int(val * 8 / 1048576 * 1024) # 粗略估算，或者直接视为错误
    
    return val

def get_first_mem_from_gjf(gjf_path):
    """
    扫描 gjf 文件，获取第一行有效的 %mem 定义
    """
    try:
        pattern = re.compile(r'^%mem\s*=\s*(\S+)', re.IGNORECASE)
        with open(gjf_path, 'r', encoding='utf-8') as f:
            for line in f:
                # 只读头部，通常 link0 命令在前 100 行内
                match = pattern.match(line.strip())
                if match:
                    return match.group(1)
    except Exception:
        pass
    return None

def auto_fix_nproc(gjf_path, target_nproc):
    """
    自动修正 gjf 文件中的核数设置。
    逻辑：找到以 %nproc 开头（不区分大小写，包括 %nprocshared）的行，
    将其数值部分修改为 target_nproc。
    如果没有找到，则在 %chk 行之后新增，或者文件开头新增。
    """
    try:
        # 读取原始内容
        with open(gjf_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        
        new_lines = []
        modified = False
        found = False
        
        # 正则匹配：以 %nproc 开头 (忽略大小写)，后面跟任意字符(如shared)，然后是 = 号
        pattern = re.compile(r'^(%nproc\w*)\s*=\s*(\d+)', re.IGNORECASE)
        chk_pattern = re.compile(r'^%chk', re.IGNORECASE)
        
        for line in lines:
            match = pattern.match(line.strip())
            if match:
                found = True
                original_key = match.group(1) # 例如 %nprocshared
                current_val = int(match.group(2))
                
                if current_val != target_nproc:
                    # 替换为目标核数，保留原本的关键字（如原来是%nproc就保留%nproc）
                    new_line = f"{original_key}={target_nproc}\n"
                    new_lines.append(new_line)
                    modified = True
                    # print(f"  [AutoFix] {gjf_path.name}: {line.strip()} -> {new_line.strip()}")
                else:
                    new_lines.append(line)
            else:
                new_lines.append(line)
        
        if not found:
            insert_idx = 0
            for i, line in enumerate(new_lines):
                if chk_pattern.match(line.strip()):
                    insert_idx = i + 1
                    break
            new_lines.insert(insert_idx, f"%nprocshared={target_nproc}\n")
            modified = True

        # 只有确实发生修改才回写文件，减少IO
        if modified:
            with open(gjf_path, 'w', encoding='utf-8') as f:
                f.writelines(new_lines)
            return True
        return False
        
    except Exception as e:
        print(f"Warning: Failed to fix nproc for {gjf_path.name}: {e}")
        return False


def auto_fix_mem(gjf_path, target_mem):
    """
    自动修正 gjf 文件中的内存设置 (%mem)。
    逻辑：找到以 %mem 开头的行（不区分大小写），将其值部分修改为 target_mem。
    保留原来的关键字大小写形式。
    如果没有找到，则在 %chk 行之后新增，或者文件开头新增。
    """
    try:
        with open(gjf_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()

        new_lines = []
        modified = False
        found = False

        pattern = re.compile(r'^(%mem)\s*=\s*(\S+)', re.IGNORECASE)
        chk_pattern = re.compile(r'^%chk', re.IGNORECASE)

        for line in lines:
            match = pattern.match(line.strip())
            if match:
                found = True
                original_key = match.group(1)
                current_val = match.group(2)

                if current_val != target_mem:
                    new_line = f"{original_key}={target_mem}\n"
                    new_lines.append(new_line)
                    modified = True
                else:
                    new_lines.append(line)
            else:
                new_lines.append(line)

        if not found:
            insert_idx = 0
            for i, line in enumerate(new_lines):
                if chk_pattern.match(line.strip()):
                    insert_idx = i + 1
                    break
            new_lines.insert(insert_idx, f"%mem={target_mem}\n")
            modified = True

        if modified:
            with open(gjf_path, 'w', encoding='utf-8') as f:
                f.writelines(new_lines)
            return True
        return False

    except Exception as e:
        print(f"Warning: Failed to fix mem for {gjf_path.name}: {e}")
        return False

def generate_bsub_content(job_name, args, input_file, g16_root_path, mem_limit_mb=None,
                          local_scratch=False, keep_scratch=False):
    """生成原本的单作业 LSF 脚本 (支持内存限制)"""
    g16_exec = f"{g16_root_path}/g16/g16"
    content = [
        f"#BSUB -J {job_name}",
        f"#BSUB -q {args.queue}",
        f"#BSUB -n {args.nproc}",
        f"#BSUB -R span[ptile={args.nproc}]",
    ]
    
    # [新增] 内存资源控制
    if mem_limit_mb and mem_limit_mb > 0:
        # select: 确保节点有足够空闲内存
        # rusage: 告诉调度器预留这些内存，防止过载
        #content.append(f'#BSUB -R "select[mem>{mem_limit_mb}MB] rusage[mem={mem_limit_mb}MB]"')
        #content.append(f'#BSUB -R "rusage[mem={mem_limit_mb}M]"')
        # -M: 硬限制，超过此内存会被 kill (根据需求是否开启，通常建议开启以防溢出)
        #content.append(f"#BSUB -M {mem_limit_mb}M")
        pass

    content.append(f"#BSUB -o {job_name}-%J.out")
    
    if args.exclusive:
        content.append("#BSUB -x")
    if args.node:
        content.append(f"#BSUB -m {args.node}")
    # 如果指定了要排除的节点
    if getattr(args, 'exclude_nodes', None):
        joined = ' && '.join([f"hname!='{n}'" for n in args.exclude_nodes])
        content.append(f'#BSUB -R "select[{joined}]"')

    content.append("")
    content.append(f"export g16root={g16_root_path}")
    content.append(f". {g16_root_path}/g16/bsd/g16.profile")

    # 本地 scratch: 在 gjf 文件所在目录创建 GAUSS_SCRDIR (包含 $LSB_JOBID)
    input_path_obj = Path(input_file).resolve()
    if local_scratch:
        try:
            parent_dir = str(input_path_obj.parent)
        except Exception:
            parent_dir = "$PWD"
        content.append(f"export GAUSS_SCRDIR={parent_dir}/g16_scr_$LSB_JOBID")
    else:
        content.append("export GAUSS_SCRDIR=/scratch/scr/$USER/$LSB_JOBID")

    content.append("mkdir -p $GAUSS_SCRDIR")
    content.append("")

    parent_dir = str(input_path_obj.parent)
    file_name = input_path_obj.name
    
    content.append(f"ORIG_DIR=\"$PWD\"")
    content.append(f"cd \"{parent_dir}\"")

    content.append("echo 'Job started at' `date`")
    content.append(f"echo 'Processing: {file_name}'")
    content.append(f"{g16_exec} < \"{file_name}\" > \"{input_path_obj.stem}.log\"")
    content.append("")
    
    # [修改] 核心：清理与保留逻辑
    if keep_scratch:
        # 获取输入文件的 stem (不带扩展名的文件名)
        # 注意：这里我们在 Shell 脚本中动态获取，或者直接用 Python 传进去的 input_path_obj.stem
        # 既然 gjf 就在当前目录运行，目标目录就是 $PWD (或者 absolute path)
        target_stem = input_path_obj.stem
        target_dir = str(input_path_obj.parent)
        
        content.append("# --- Keep Scratch Mode ---")
        content.append(f"echo 'Moving and renaming scratch files to {target_dir} ...'")
        # 遍历 Scratch 目录下的所有文件
        # 逻辑：获取扩展名 -> mv 原文件 目标目录/stem.扩展名
        content.append(f'for f in "$GAUSS_SCRDIR"/*; do')
        content.append(f'    if [ -f "$f" ]; then')
        content.append(f'        ext="${{f##*.}}"') # Shell 参数扩展获取后缀
        content.append(f'        mv -f "$f" "{target_dir}/{target_stem}.${{ext}}"')
        content.append(f'    fi')
        content.append(f'done')
        # 移完之后删除空目录
        content.append("rm -rf $GAUSS_SCRDIR")
    else:
        # 默认直接删除
        content.append("rm -rf $GAUSS_SCRDIR")
    content.append("echo 'Job finished at' `date`")
    content.append(f"cd \"$ORIG_DIR\"")
    return "\n".join(content)

def generate_packed_bsub_content(job_name, args, file_chunk, g16_root_path, intended_batch_size, 
                                 local_scratch=False, keep_scratch=False):
    """
    生成打包作业 LSF 脚本 (修正版：强制资源申请量 + 内存控制)
    """
    g16_exec = f"{g16_root_path}/g16/g16"
    
    # 始终按用户设定的 batch_size 申请核数
    total_nproc = intended_batch_size * 28
    actual_run_count = len(file_chunk)
    
    # [新增] Batch 模式强制内存设置 (180GB)
    # 解析 180GB 为 MB
    batch_mem_mb = parse_mem_to_mb(BATCH_MEM_FIXED)
    
    # Python端传递绝对路径列表
    inputs_str = '"' + '" "'.join([str(f.absolute()) for f in file_chunk]) + '"'
    
    content = [
        f"#!/bin/bash",
        f"#BSUB -J {job_name}",
        f"#BSUB -q {args.queue}",
        f"#BSUB -n {total_nproc}",
        f"#BSUB -R span[ptile=28]",
    ]

    # [新增] Batch 模式下的资源申请
    # 由于 ptile=28 意味着每个节点跑一个 Gaussian 任务 (28核)
    # 我们需要的内存限制是针对 *每个节点* 的 (或者说每个 slot 组)
    # LSF 中 rusage[mem=X] 在 span 存在时的行为较复杂，通常理解为 per-host 或 per-job
    # 既然目标是防止被挤死，我们申请单节点所需的量即可 (180GB)
    if batch_mem_mb > 0:
        #content.append(f'#BSUB -R "select[mem>{batch_mem_mb}MB] rusage[mem={batch_mem_mb}MB]"')
        content.append(f'#BSUB -R "rusage[mem={batch_mem_mb}M]"')
        content.append(f"#BSUB -M {batch_mem_mb}M")

    content.append(f"#BSUB -o {job_name}-%J.out")
    content.append("")
    content.append(f"# ================= JOB PACKING SETUP =================")
    content.append(f"# Batch Config: Requested {intended_batch_size} slots, Running {actual_run_count} tasks")
    content.append(f"# Memory Config: Fixed to {BATCH_MEM_FIXED} ({batch_mem_mb} MB) per node/task")
    content.append(f"export g16root={g16_root_path}")
    content.append(f". {g16_root_path}/g16/bsd/g16.profile")
    
    if getattr(args, 'exclude_nodes', None):
        joined = ' && '.join([f"hname!='{n}'" for n in args.exclude_nodes])
        # 插入到 select 条件中 (如果之前没有select，这里要小心)
        # 简单起见，追加一个新的 select 限制行
        content.insert(5, f'#BSUB -R "select[{joined}]"')

    content.extend([
        "",
        "hosts_list=$(echo $LSB_HOSTS | tr ' ' '\\n' | sort | uniq)",
        "hosts_array=($hosts_list)",
        "",
        f"input_paths=({inputs_str})",
        "",
        "echo 'Allocation confirmed on nodes: ${hosts_array[*]}'",
        "echo 'Job started at' `date`",
        "",
        f"for i in {{0..{actual_run_count - 1}}}; do",
        "    node=${hosts_array[$i]}",
        "    full_path=${input_paths[$i]}",
        "",
        "    work_dir=$(dirname \"$full_path\")",
        "    filename=$(basename \"$full_path\")",
        "    job_stem=\"${filename%.*}\"",     # 获取不带后缀的文件名 (如 calc)
        "    output=\"${job_stem}.log\"",
        "",
        # [核心修改] 动态构建 blaunch 内部的 Scratch 路径
    ])

    # 1. 确定 Scratch 目录路径的 Shell 表达式
    if local_scratch:
        # 使用工作目录下的 g16_scr_i_JOBID
        # 注意转义：\$work_dir 在 blaunch 运行时展开
        scr_dir_expr = r"$work_dir/g16_scr_${i}_$LSB_JOBID"
    else:
        # 使用公共 scratch
        scr_dir_expr = r"/scratch/scr/$USER/g16_scr_${i}_$LSB_JOBID"

    # 2. 确定 清理/保留 命令的 Shell 表达式
    # 这一串命令要在 blaunch 的 "..." 字符串内部运行，所以引号转义要非常小心
    # 我们用 Python 构造这个字符串
    if keep_scratch:
        # 逻辑：遍历 dir/* -> mv to work_dir/stem.ext -> rm dir
        # 注意：在 blaunch 的双引号字符串中，内部的 $ 必须转义为 \$ 才能留给远程 Shell 执行
        # 内部的双引号 " 必须转义为 \"
        cleanup_cmd = (
            f"for f in \\\"{scr_dir_expr}\\\"/*; do " 
            f"ext=\\$\{{f##*.}}; " # 获取后缀
            f"mv -f \\\"\\$f\\\" \\\"\\$work_dir/\\$job_stem.\\$ext\\\"; " 
            f"done && "
            f"rm -rf \\\"{scr_dir_expr}\\\""
        )
    else:
        cleanup_cmd = f"rm -rf \\\"{scr_dir_expr}\\\""

    content.extend([
        f"    echo \"Launching $filename on node $node (Dir: $work_dir)\"",
        "",
        # blaunch 命令行构建
        f"    blaunch $node \"cd \\\"$work_dir\\\" && \\",
        f"                   mkdir -p \\\"{scr_dir_expr}\\\" && \\",
        f"                   export g16root={g16_root_path} && \\",
        f"                   . {g16_root_path}/g16/bsd/g16.profile && \\",
        f"                   export GAUSS_SCRDIR=\\\"{scr_dir_expr}\\\" && \\",
        f"                   {g16_exec} < \\\"$filename\\\" > \\\"$output\\\" && \\",
        f"                   {cleanup_cmd}\" &", # 插入构建好的清理命令
        "done",
        "",
        "wait",
        "echo 'All packed jobs finished at' `date`"
    ])
    return "\n".join(content)

def submit_job(bsub_content, job_name, work_dir, pause_mode=False, keep=False):
    """
    通用的提交底层函数
    :param pause_mode: 如果为 True，则只生成文件，不提交也不删除
    """
    original_cwd = os.getcwd()
    os.chdir(work_dir)
    try:
        bsub_filename = f"{job_name}.bsub"
        
        # 1. 写入脚本文件
        with open(bsub_filename, 'w') as f:
            f.write(bsub_content)
        
        # 2. 如果是暂停模式，打印提示并直接返回（保留文件）
        if pause_mode:
            print(f"  [Saved] Script generated at: {os.path.join(work_dir, bsub_filename)}")
            return True

        # 3. 正常模式：提交并清理（可选保留脚本）
        with open(bsub_filename, 'r') as f:
            subprocess.run("bsub", stdin=f, stdout=subprocess.DEVNULL, check=True)

        # 根据 keep 标志决定是否删除脚本文件
        if not keep:
            os.remove(bsub_filename)
        return True

    except Exception as e:
        print(f"Error handling {job_name}: {e}")
        return False
    finally:
        os.chdir(original_cwd)


def main():
    # 定义示例文字 (你可以按照这个格式继续添加更多例子)
