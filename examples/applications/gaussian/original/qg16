            # [修改] 2. 智能内存判定逻辑
            # 优先级: 命令行参数 --mem > 文件内原有 %mem > 默认保底 (100GB)
            target_mem_str = None
            
            if args.mem:
                target_mem_str = args.mem
                # 如果用户指定了强制改内存，这里修改文件
                if auto_fix_mem(gjf, args.mem):
                    print(f"(mem->{args.mem}) ", end='', flush=True)
            else:
                # 没指定参数，尝试从文件读
                file_mem = get_first_mem_from_gjf(gjf)
                if file_mem:
                    target_mem_str = file_mem
                    # print(f"(read mem: {file_mem}) ", end='', flush=True)
                else:
                    # 文件里也没写，使用保底值
                    target_mem_str = DEFAULT_MEM_FALLBACK
                    # 既然文件里没写，最好把它写进去，或者单纯只在LSF里限制？
