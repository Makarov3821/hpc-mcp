    # ... (参数定义保持不变) ...
    parser.add_argument("input", nargs='?', default=".", help="输入文件 (.gjf) 或 目录")
    parser.add_argument("-r", "--recursive", action="store_true", help="递归查找子目录")
    parser.add_argument("--upon-failure", action="store_true", help="如果Log显示Normal termination则跳过")
    parser.add_argument("--upon-ad-failure", action="store_true",
                        help="高级检测：跳过 '已完成' 或 '正在队列中(Run/Pend)' 的任务")
    
    parser.add_argument("-q", "--queue", default=DEFAULT_QUEUE, help=f"指定队列 (默认: {DEFAULT_QUEUE})")
    parser.add_argument("-n", "--nproc", default=DEFAULT_NPROC, type=int, help=
                        f"指定核数 (单作业模式默认: {DEFAULT_NPROC})")
    parser.add_argument("--batch-size", type=int, default=4, help=
                        "[Batch模式] 每个LSF作业打包运行的Gaussian作业数 (4-32, 默认: 4)")

    parser.add_argument("-v", "--version", default=DEFAULT_VERSION, choices=G16_VERSIONS.keys(), 
                        help=f"G16版本: {', '.join(G16_VERSIONS.keys())} (默认: {DEFAULT_VERSION})。目前除A03与C02外，其他的版本都是基于B01构建的。")
    parser.add_argument("-x", "--exclusive", action="store_true", help="独占节点模式 (#BSUB -x)")
    parser.add_argument("-m", "--node", help="指定节点运行 (#BSUB -m node_name)")
    parser.add_argument("-y", "--yes", action="store_true", help="自动确认")
    # [新增] 暂停模式开关
    parser.add_argument("-P", "--pause", action="store_true", help="仅生成 .bsub 脚本但不提交，也不删除脚本")
    # [新增] 保留 .bsub 文件开关（提交后不删除生成的脚本）
    parser.add_argument("-k", "--keep", action="store_true",
                        help="提交后保留生成的 .bsub 脚本文件 (不删除)")
    # [新增] 内存设置 (%%mem)
    parser.add_argument("--mem", help="设置Gaussian作业中的 %%mem 大小 (例如 '32GB' 或 '16000MB')。" \
                        "若不指定则自动探测gjf文件，若探测失败则默认100GB。")    
    # [新增] 排除节点列表 (-X)
    parser.add_argument("-X", "--exclude-nodes", nargs='+',
                        help="最好不要最后一个设定这个参数！！排除指定节点（一个或多个），" \
                        "在LSF脚本中使用 select[hname!='n1' && hname!='n2']")

    # [新增] 本地 scratch 选项
    # 似乎目前脚本里的逻辑无法完成这两个目标，所以先注释掉
    # local_scratch的问题是没办法设定GAUSS_SCRDIR改变到家目录，不可抗力
    # keep_scratch的问题是g16计算结束后就会自己将scr里面的临时文件都自动删除，所以在LSF脚本中cp没有意义
    # 这两点其实都可以通过直接改变gjf来做到，比如对于rwf，设定keep可以直接修改gjf，在gjf中手动指定rwf的位置，这样结束时就不会被自动删除
    # local-scratch的意义则不大，因为测试下来用网络硬盘柜计算速度会过于慢
#    parser.add_argument("--local-scratch", action="store_true",
#                        help="在 .gjf 所在目录下创建 GAUSS_SCRDIR (默认: /scratch/scr/$USER/...)")
#    parser.add_argument("--keep-scratch", action="store_true",
#                        help="计算结束后，将 scratch 文件(rwf/chk等) 移回 .gjf 所在目录，" \
#                             "并重命名为与 .gjf 同名，最后删除 scratch 目录。")
    args = parser.parse_args()

    # 1. 扫描文件
    target_path = Path(args.input)
    is_dir_mode = False 
    all_tasks = []

    if target_path.is_file() and target_path.suffix == '.gjf':
        all_tasks.append(target_path.absolute())
    elif target_path.is_dir():
        is_dir_mode = True
        print(f"正在扫描目录: {target_path} ...")
        if args.recursive:
            all_tasks = list(target_path.rglob("*.gjf"))
        else:
            all_tasks = list(target_path.glob("*.gjf"))
    else:
        print(f"错误: 路径不存在或类型不符 {target_path}")
        sys.exit(1)

    all_tasks.sort()
    
    # 2. 过滤任务
    to_submit = []
    to_skip = []
    
    # 获取“活跃文件指纹库” (包含正在排队或运行的文件的绝对路径)
    active_paths_set = set()
    if args.upon_ad_failure:
        print("正在深度分析 LSF 队列 (Directory + Command)...")
        active_paths_set = get_active_file_paths()
        # if active_paths_set: print(f"DEBUG: Active files: {len(active_paths_set)}")

    for gjf in all_tasks:
        should_skip = False
        skip_reason = ""
        
        # 1. 检查 Log 是否完成 (基础功能)
        check_log = args.upon_failure or args.upon_ad_failure
        if check_log and check_job_finished(gjf):
            should_skip = True
            skip_reason = "Finished"
        
        # 2. 检查是否在队列中 (高级功能：绝对路径比对)
        # 仅当 Log 没显示完成时，才去检查队列
        if args.upon_ad_failure and not should_skip:
            # 获取当前扫描文件的绝对路径字符串
            current_abs_path = str(gjf.resolve())
            
            if current_abs_path in active_paths_set:
                should_skip = True
                skip_reason = "In Queue/Running"

        if should_skip:
            # 可选：打印跳过详情
            #print(f"  [Skip] {gjf.name} -> {skip_reason}")
            to_skip.append(gjf)
        else:
            to_submit.append(gjf)
    # 3. 判定是否启用 Batch Packing 模式
    enable_batch_mode = is_dir_mode and (args.queue in BATCH_QUEUES)
    task_chunks = []

    if enable_batch_mode:
        if not (4 <= args.batch_size <= 32):
            print("错误: --batch-size 必须在 4 到 32 之间")
            sys.exit(1)
        # 计算分组
        task_chunks = [to_submit[i:i + args.batch_size] for i in range(0, len(to_submit), args.batch_size)]

    # ================= 4. 交互确认 (界面优化版) =================
    if is_dir_mode and not args.yes:
        print("\n" + "="*55)
        print(f" 任务预扫描报告")
        print("="*55)
        
        # 基础信息
        print(f" 扫描路径     : {target_path}")
        print(f" 队列 (Queue) : {args.queue}")
        print(f" 版本 (Ver)   : {args.version}")
        print(f" 找到文件总数 : {len(all_tasks)}")
        print(f" \033[92m已完成/跳过  : {len(to_skip)}\033[0m")
        # [新增] 如果开启了 Pause 模式，显示显眼提示
        if args.pause:
            print(f" \033[96m模式 (Mode)   : PAUSE (仅生成脚本，不提交)\033[0m")
        
        # 重点：待提交部分的显示逻辑
        if enable_batch_mode:
            # Batch 模式特有显示
            lsf_job_count = len(task_chunks)
            total_cores = args.batch_size * 28
            print("-" * 55)
            print(f" \033[93m[Batch Mode 已激活]\033[0m")
            print(f" 待处理任务   : {len(to_submit)}")
            print(f" \033[1m分组策略     : 每 {args.batch_size} 个 Gaussian 任务 -> 1 个 LSF 作业\033[0m")
            print(f" \033[1m预计提交     : {lsf_job_count} 个 LSF 作业\033[0m")
            print(f" 资源申请     : 每个 LSF 作业索要 {total_cores} 核 (span[ptile=28])")
            print("-" * 55)
        else:
            # 普通模式
            print(f" \033[91m计划提交     : {len(to_submit)} 个单独作业\033[0m")
            print(f" 资源申请     : 每个作业 {args.nproc} 核")
            print("-" * 55)
        
        if len(to_submit) > 0:
            if enable_batch_mode:
                print(" 前 2 个分组结构预览:")
                for i, chunk in enumerate(task_chunks[:2]):
                    print(f"  [Group {i+1}]: 包含 {len(chunk)} 个任务")
                    for f in chunk[:3]: # 每组只显示前3个文件，避免刷屏
                        print(f"      - {f.name}")
                    if len(chunk) > 3:
                        print(f"      ... (以及其他 {len(chunk)-3} 个)")
            else:
                print(" 前 5 个将要提交的任务:")
                for t in to_submit[:5]:
                    print(f"  - {t.name}")
            
            print("-" * 55)
            try:
                # 提示文字根据模式变化
                prompt_text = "确认提交这些分组作业吗?" if enable_batch_mode else "确认提交吗?"
                confirm = input(f"{prompt_text} [y/N]: ").strip().lower()
            except KeyboardInterrupt:
                sys.exit(0)
            if confirm != 'y':
                print("已取消。")
                sys.exit(0)
        else:
            print("\n没有需要提交的任务。")
            sys.exit(0)

    # 5. 执行提交
    print(f"\n开始提交...\n")
    g16_root = G16_VERSIONS[args.version]
    success_count = 0

    if enable_batch_mode:
        # ================= Batch 模式 (内存逻辑更新) =================
        for i, chunk in enumerate(task_chunks, 1):
            
            # [修改] 1. 强制修正 Batch 模式下的核数(28) 和 内存(BATCH_MEM_FIXED = 180GB)
            # 这是为了防止被其他任务挤死，遵循用户设定的保险策略
            for gjf in chunk:
                if auto_fix_nproc(gjf, 28): 
                    print(f"  [AutoFix] {gjf.name}: %nproc set to 28")
                
                # 强制修改内存为 180GB (或者你在配置区定义的 BATCH_MEM_FIXED)
                if auto_fix_mem(gjf, BATCH_MEM_FIXED):
                    print(f"  [AutoFix] {gjf.name}: %mem set to {BATCH_MEM_FIXED} (Batch Policy)")

            first_stem = chunk[0].stem
            job_name = f"B{i}_{first_stem[:6]}" 
            
            print(f"[{i}/{len(task_chunks)}] Submitting Group {i} ... ", end='')
            if len(chunk) < args.batch_size:
                print(f"(Partial: {len(chunk)}/{args.batch_size}) ... ", end='')
            else:
                print(f"({len(chunk)} files) ... ", end='')
            
            # 生成脚本 (内部已经处理了 180GB 的 LSF 资源申请)
            # [修改] 调用 generate_packed_bsub_content，传递新参数
            bsub_content = generate_packed_bsub_content(
