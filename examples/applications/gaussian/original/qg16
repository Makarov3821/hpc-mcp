    else:
        # ================= 普通单作业模式 (内存逻辑更新) =================
        for i, gjf in enumerate(to_submit, 1):
            try:
                rel_name = gjf.relative_to(os.getcwd())
            except ValueError:
                rel_name = gjf.name
                
            print(f"[{i}/{len(to_submit)}] Submitting: {rel_name} ... ", end='', flush=True)
            
            # 1. 修正核数
            if auto_fix_nproc(gjf, args.nproc):
