                    if auto_fix_mem(gjf, DEFAULT_MEM_FALLBACK):
                        print(f"(default mem->{DEFAULT_MEM_FALLBACK}) ", end='', flush=True)

            # 计算 MB 值用于 LSF 申请
            mem_mb_for_lsf = parse_mem_to_mb(target_mem_str)
            
            job_name = gjf.stem[0:10]
            # 传递 mem_limit_mb 到生成器，并使用 gjf 的完整路径以便 local-scratch 定位
            # [修改] 调用 generate_bsub_content，传递新参数
            bsub_content = generate_bsub_content(
